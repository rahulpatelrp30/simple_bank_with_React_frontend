{
  "info": {
    "name": "Simple Bank API (JWT + roles)",
    "description": "Start the API with `python -m uvicorn main:app --reload`, then run the whole collection with the Collection Runner.\n\nThe server generates a JWT on login. The token contains the user's role, so there are two kinds: AdminToken and CustomerToken. Requests save them automatically into {{adminToken}} and {{customerToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "1. Customer Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Registers a new customer. The server generates a JWT (CustomerToken).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"username\": \"{{username}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New username every run so signup never clashes",
                  "pm.collectionVariables.set(\"username\", \"cust\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "    pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Server returns a CustomerToken\", () => pm.expect(data.tokenType).to.eql(\"CustomerToken\"));",
                  "    pm.test(\"Role is CUSTOMER\", () => pm.expect(data.role).to.eql(\"CUSTOMER\"));",
                  "    pm.collectionVariables.set(\"customerToken\", data.token);",
                  "    pm.collectionVariables.set(\"customerId\", data.user.userId);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Sign Up With Username admin (should fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Business rule: only the admin can have the username \"admin\".",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Fake\",\n  \"lastName\": \"Admin\",\n  \"username\": \"admin\",\n  \"email\": \"fake{{$timestamp}}@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "    pm.test(\"Status is 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "    pm.test(\"Message: The username \\\"admin\\\" is reserved\", () => pm.expect(pm.response.json().detail).to.eql(\"The username \\\"admin\\\" is reserved\"));",
                  "})();"
                ]
              }
            }
          ]
        },
