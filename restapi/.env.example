# Copy this file to ".env" and fill in your own values.
# The .env file is NOT uploaded to GitHub, because it contains secrets.

# Local MongoDB:
MONGO_URL=mongodb://localhost:27017
# MongoDB Atlas (replace with your own connection string):
# MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGO_DB=simple_bank_v2
JWT_SECRET=put-a-long-random-secret-here-at-least-32-characters
ADMIN_PASSWORD=admin123
PREMIUM_THRESHOLD=10000
